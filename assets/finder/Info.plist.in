<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleName</key><string>IKView Finder</string>
  <key>CFBundleDisplayName</key><string>IKView Finder</string>
  <key>CFBundleExecutable</key><string>IKViewFinder</string>
  <key>CFBundleIdentifier</key><string>io.ikview.desktop.finder</string>
  <key>CFBundleVersion</key><string>@PROJECT_VERSION@</string>
  <key>CFBundleShortVersionString</key><string>@PROJECT_VERSION@</string>
  <key>CFBundlePackageType</key><string>XPC!</string>
  <key>LSMinimumSystemVersion</key><string>@CMAKE_OSX_DEPLOYMENT_TARGET@</string>
  <key>LSUIElement</key><true/>
  <key>NSExtension</key><dict>
    <key>NSExtensionAttributes</key><dict/>
    <key>NSExtensionPointIdentifier</key><string>com.apple.FinderSync</string>
    <key>NSExtensionPrincipalClass</key><string>IKViewFinder</string>
  </dict>
</dict></plist>
